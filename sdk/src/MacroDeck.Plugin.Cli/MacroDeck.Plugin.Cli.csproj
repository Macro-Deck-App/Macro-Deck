<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RollForward>latestMajor</RollForward>
        <InvariantGlobalization>true</InvariantGlobalization>
        <!-- Every type in this project stays internal - see AssemblyInfo.cs - so GenerateDocumentationFile
             (on by default for a packable project, see Directory.Build.targets) has no public surface to
             demand documentation comments for. -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <IsMacroDeckPackage>true</IsMacroDeckPackage>
        <PackageId>MacroDeck.Plugin.Cli</PackageId>
        <Description>macrodeck-plugin: the Macro Deck plugin developer CLI. Validate a manifest, inspect or pack a .macroDeckPlugin artifact, run a plugin against a stub or real host, and run the conformance suite against it - all as a dotnet tool.</Description>
        <PackageTags>macrodeck;plugin;cli;tool</PackageTags>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>macrodeck-plugin</ToolCommandName>
    </PropertyGroup>

    <ItemGroup>
        <!-- Referenced for the localization compiler alone: PluginLanguages reads a project's .resx set
             through the very same file-name and culture-name rules the source generator uses, so the
             'languages' this tool writes into a manifest can never disagree with the catalog the plugin
             actually ships. Those types are internal, hence this project's InternalsVisibleTo there. -->
        <ProjectReference Include="..\MacroDeck.Localization\MacroDeck.Localization.csproj" />
        <ProjectReference Include="..\MacroDeck.Plugin.Packaging\MacroDeck.Plugin.Packaging.csproj" />
        <ProjectReference Include="..\MacroDeck.Plugin.Testing\MacroDeck.Plugin.Testing.csproj" />
        <ProjectReference Include="..\MacroDeck.Signing\MacroDeck.Signing.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="System.CommandLine" />
        <PackageReference Include="JsonSchema.Net" />
        <PackageReference Include="Spectre.Console" />
    </ItemGroup>

    <PropertyGroup>
        <PreviewRendererUi>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', '..', 'ui'))</PreviewRendererUi>
        <PreviewRendererOutput>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'preview-renderer'))</PreviewRendererOutput>
        <PreviewRendererAvailable Condition="Exists('$(PreviewRendererUi)node_modules/esbuild')">true</PreviewRendererAvailable>
    </PropertyGroup>

    <ItemGroup>
        <PreviewRendererInput Include="$(PreviewRendererUi)preview-renderer/**/*;$(PreviewRendererUi)runtime/src/**/*;$(PreviewRendererUi)runtime/styles/**/*;$(PreviewRendererUi)scripts/build-preview-renderer.mjs;$(PreviewRendererUi)package-lock.json" />
    </ItemGroup>

    <Target Name="BuildPreviewRenderer"
            Condition="'$(PreviewRendererAvailable)' == 'true' and '$(DesignTimeBuild)' != 'true'"
            Inputs="@(PreviewRendererInput)"
            Outputs="$(PreviewRendererOutput)/preview-renderer.js.gz;$(PreviewRendererOutput)/preview-renderer.css.gz">
        <Exec Command="node &quot;$(PreviewRendererUi)scripts/build-preview-renderer.mjs&quot; &quot;$(PreviewRendererOutput)&quot;" />
    </Target>

    <Target Name="EmbedPreviewRenderer" BeforeTargets="BeforeBuild" DependsOnTargets="BuildPreviewRenderer">
        <Message Importance="high" Condition="'$(PreviewRendererAvailable)' != 'true'"
                 Text="MacroDeck.Plugin.Cli: ui/node_modules is missing, building without the preview renderer. Run npm ci in ui to embed it." />
        <ItemGroup Condition="'$(PreviewRendererAvailable)' == 'true'">
            <EmbeddedResource Include="$(PreviewRendererOutput)/preview-renderer.js.gz" LogicalName="preview-renderer.js.gz" />
            <EmbeddedResource Include="$(PreviewRendererOutput)/preview-renderer.css.gz" LogicalName="preview-renderer.css.gz" />
        </ItemGroup>
    </Target>

    <Target Name="RequirePreviewRenderer" BeforeTargets="GenerateNuspec">
        <Error Condition="!Exists('$(PreviewRendererOutput)/preview-renderer.js.gz')"
               Text="MacroDeck.Plugin.Cli cannot be packed without the preview renderer: run npm ci in ui and build again." />
    </Target>

    <ItemGroup>
        <InternalsVisibleTo Include="MacroDeck.Plugin.Cli.Tests.UnitTests" />
    </ItemGroup>

</Project>
