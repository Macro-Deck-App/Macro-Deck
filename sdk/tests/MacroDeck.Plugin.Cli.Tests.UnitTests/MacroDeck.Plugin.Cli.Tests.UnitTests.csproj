        <ProjectReference Include="..\fixtures\MacroDeck.Plugin.Testing.Tests.WellBehavedPlugin\MacroDeck.Plugin.Testing.Tests.WellBehavedPlugin.csproj"
                           ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\fixtures\MacroDeck.Plugin.Testing.Tests.MisbehavingPlugin\MacroDeck.Plugin.Testing.Tests.MisbehavingPlugin.csproj"
                           ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="NUnit.Framework"/>
