# Windows shortcuts
*.lnk

testresults.trx
TestResults
publish

# Local private key material only (see docs/src/content/docs/cli/signing.md).
# Anchored: a bare "keys" also matched source directories such as
# sdk/src/MacroDeck.Signing/Keys/ and silently kept them out of the repository.
/keys/
database.db

# Bootstrapper packaging staging/output (keep the dir itself: tauri-build
# validates the bundle resources path at compile time, so it must exist in a
# fresh checkout for cargo check/clippy/test on Windows/Linux)
ui/bootstrapper/host-publish/*
!ui/bootstrapper/host-publish/.gitkeep
# Auto-generated by tauri-build from the app_manifest in build.rs
ui/bootstrapper/permissions/
ui/bootstrapper/gen/
ui/bootstrapper/version-override.json

# Throwaway solution + diff produced by the ReSharper formatting check (CI + local repro)
MacroDeck.Format.sln
formatting.diff

# Astro Starlight documentation site (docs/)
docs/dist/
docs/.astro/
.wrangler/

# Playwright E2E output
playwright-report/
test-results/
