<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <!-- CA1861: flagged on inline array literals inside Assert.That(...) calls - not the
             repeated-hot-path case the rule targets. Same suppression as
             MacroDeckHost.Tests.PluginContractTests.csproj. -->
        <NoWarn>$(NoWarn);CA1707;CA1861</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" />
        <PackageReference Include="Microsoft.AspNetCore.TestHost" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="NUnit" />
        <PackageReference Include="NUnit.Analyzers" />
        <PackageReference Include="NUnit3TestAdapter" />
        <PackageReference Include="SixLabors.ImageSharp" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\MacroDeckHost\MacroDeckHost.csproj" />
        <ProjectReference Include="..\..\src\MacroDeckHost.Application\MacroDeckHost.Application.csproj" />
        <ProjectReference Include="..\..\src\MacroDeckHost.Infrastructure\MacroDeckHost.Infrastructure.csproj" />
        <ProjectReference Include="..\..\src\MacroDeckHost.Integrations\MacroDeckHost.Integrations.csproj" />
        <ProjectReference Include="..\..\src\MacroDeckHost.Widgets\MacroDeckHost.Widgets.csproj" />
        <ProjectReference Include="..\..\..\ui-model\src\MacroDeck.Ui.Testing\MacroDeck.Ui.Testing.csproj" />
        <ProjectReference Include="..\..\..\sdk\src\MacroDeck.Sdk\MacroDeck.Sdk.csproj" />
        <ProjectReference Include="..\..\..\sdk\src\MacroDeck.Signing\MacroDeck.Signing.csproj" />
        <ProjectReference Include="..\..\..\sdk\tests\support\MacroDeck.Signing.TestSupport\MacroDeck.Signing.TestSupport.csproj" />
        <!-- Reference-only, to guarantee build ordering: PluginProcessLauncherTests locates and runs the
             fixture's own build output (PluginStubLocator), it does not link against its assembly. -->
        <ProjectReference Include="..\fixtures\MacroDeckHost.Tests.PluginStub\MacroDeckHost.Tests.PluginStub.csproj"
                           ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="NUnit.Framework"/>
    </ItemGroup>

</Project>
