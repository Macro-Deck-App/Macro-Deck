<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- An internal host layer, never a published package - dotnet pack MacroDeck.slnx would
             otherwise produce a nupkg for it with no readme and no intentional public surface. -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\sdk\src\MacroDeck.Sdk\MacroDeck.Sdk.csproj" />
        <!-- The DSL, not the host's UI layer: an integration builds a tree exactly as a plugin does. -->
        <ProjectReference Include="..\..\..\ui-model\src\MacroDeck.Ui\MacroDeck.Ui.csproj" />
        <ProjectReference Include="..\..\..\sdk\src\MacroDeck.Localization\MacroDeck.Localization.csproj" />
        <ProjectReference Include="..\MacroDeckHost.Localization\MacroDeckHost.Localization.csproj" />
        <ProjectReference Include="..\MacroDeckHost.Platform\MacroDeckHost.Platform.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="MacroDeck.Sdk.Input" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="MailKit" />
      <PackageReference Include="SpotifyAPI.Web" />
      <PackageReference Include="obs-websocket-dotnet" />
      <PackageReference Include="SoundpadConnector" />
      <PackageReference Include="TwitchLib.Api" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="**\*.svg" />
      <EmbeddedResource Include="**\*.png" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="MacroDeckHost.Tests.UnitTests" />
      <InternalsVisibleTo Include="MacroDeckHost.Tests.UnitTests.Windows" />
      <InternalsVisibleTo Include="MacroDeckHost.Tests.UnitTests.MacOS" />
      <InternalsVisibleTo Include="MacroDeckHost.Tests.UnitTests.Linux" />
    </ItemGroup>

</Project>
