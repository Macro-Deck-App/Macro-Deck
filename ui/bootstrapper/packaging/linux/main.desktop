[Desktop Entry]
Categories={{categories}}
{{#if comment}}
Comment={{comment}}
{{/if}}
# %U is what makes the file and macrodeck:// associations work: a bare Exec gets no arguments, and only %u/%U
# receives non-file URIs. Never on StartupWMClass, which stays the plain binary name.
Exec={{exec}} %U
StartupWMClass={{exec}}
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
{{#if mime_type}}
MimeType={{mime_type}}
{{/if}}
Keywords=macro;deck;streamdeck;automation;remote;control;
Keywords[de]=macro;deck;streamdeck;automatisierung;fernsteuerung;steuerung;
GenericName=Control surface
GenericName[de]=Steuerpult
