{
  "name": "@macro-deck/web-client",
  "version": "0.0.0",
  "private": true,
  "description": "The Macro Deck web client: a deck, without a framework.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:carthing": "node build.mjs --target=carthing",
    "check:es5": "es-check es5 \"dist/main-*.js\" \"dist/polyfills-*.js\"",
    "pretest": "tsc -p tsconfig.spec.json && node -e \"require('fs').writeFileSync('out-spec/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\"",
    "test": "jasmine --config=jasmine.json",
    "test:legacy": "node --test legacy/*.test.mjs"
  },
  "dependencies": {
    "@macro-deck/runtime": "*"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@ungap/structured-clone": "^1.4.0",
    "abort-controller": "^3.0.0",
    "autoprefixer": "^10.5.4",
    "browserslist": "^4.28.1",
    "caniuse-lite": "^1.0.30001759",
    "core-js": "^3.50.0",
    "es-check": "^7.2.1",
    "esbuild": "^0.28.1",
    "jasmine": "^5.6.0",
    "jasmine-core": "~5.6.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.26",
    "raf": "^3.4.1",
    "regenerator-runtime": "^0.14.1",
    "resize-observer-polyfill": "^1.5.1",
    "typescript": "~6.0.3",
    "whatwg-fetch": "^3.6.20"
  }
}
