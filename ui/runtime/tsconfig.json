{
  "compilerOptions": {
    // ES5 emit is the web client's device compatibility floor, so this project cannot move past
    // TypeScript 6: TypeScript 7 removed the ES5 target and downlevelIteration outright.
    "ignoreDeprecations": "6.0",
    "target": "ES5",
    "module": "ES2015",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "rootDir": "./src",
    "downlevelIteration": true,
    "importHelpers": false,
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  }
}
