# Editor configuration, see https://editorconfig.org
# The Angular workspace under ui/ has its own root .editorconfig and is not covered here.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = tab
indent_size = 4
tab_width = 4
max_line_length = 120

[*.{csproj,props,targets,slnx}]
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.md]
max_line_length = off
trim_trailing_whitespace = false
