---
// Replaces Starlight's site title so the header carries the same Macro Deck wordmark as macro-deck.app, with
// "Docs" set apart next to it instead of a plain "Macro Deck Docs" in the accent color. Screen readers get the
// configured title from the sr-only span.
import { logos } from 'virtual:starlight/user-images';

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
const logo = logos.dark;
---

<a href={siteTitleHref} class="site-title">
	{logo && <img alt="" src={logo.src} width={logo.width} height={logo.height} />}
	<span class="wordmark" translate="no" aria-hidden="true">Macro Deck</span>
	<span class="docs-label" aria-hidden="true">Docs</span>
	<span class="sr-only">{siteTitle}</span>
</a>

<style>
	.site-title {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		min-width: 0;
		color: var(--sl-color-white);
		text-decoration: none;
		white-space: nowrap;
	}

	img {
		width: 32px;
		height: 32px;
		border-radius: 6px;
	}

	/* Anta is only used for the Macro Deck wordmark, as on the website (SIL Open Font License, see
	 * public/fonts/Anta-OFL.txt). */
	.wordmark {
		font-family: 'Anta', system-ui, sans-serif;
		font-size: 1.25rem;
		letter-spacing: 0.01em;
	}

	.docs-label {
		padding: 0.0625rem 0.5rem;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 999px;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		font-weight: 500;
	}
</style>
