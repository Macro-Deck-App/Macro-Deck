// One Worker serves both channels: deploy for the released docs, a preview alias for beta.
// See "Channels and deployment" in docs/README.md.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "macro-deck-dev-docs",
	"compatibility_date": "2026-08-14",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	}
}
