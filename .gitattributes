# Normalize line endings on commit; check out with native endings.
* text=auto eol=lf

# Binary assets - never normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.dmg binary
*.exe binary
*.dll binary
*.zip binary
*.ttf binary
*.woff binary
*.woff2 binary

# Signed fixtures: their signatures cover the exact bytes.
sdk/tests/fixtures/signing-vectors/v1-chain/** -text
